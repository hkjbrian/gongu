	<string>com.gongu.agent-pipeline</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/hankyungjun/projects/gongu/server/tools/agent-pipeline/dispatch.sh</string>
	</array>
