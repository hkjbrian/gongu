# 에이전트 파이프라인 설정 — dispatch.sh 가 source 한다.

# 전역 스위치. true 가 아니면 정기 실행(tick)은 아무것도 하지 않는다. (--stage 수동 실행은 무시)
PIPELINE_ENABLED=false

REPO=hkjbrian/gongu

# 단계별 모델 (claude CLI 별칭 또는 전체 모델 ID)
MODEL_PROPOSE=opus
MODEL_PLAN=opus
MODEL_IMPLEMENT=opus
MODEL_REVIEW=opus

# 단계별 타임아웃 (gtimeout 형식)
TIMEOUT_PROPOSE=30m
TIMEOUT_PLAN=30m
TIMEOUT_IMPLEMENT=120m
TIMEOUT_REVIEW=60m

# 에이전트 A: 대기 백로그가 BACKLOG_MIN 미만이고 마지막 제안 후 PROPOSE_INTERVAL_HOURS 경과 시 실행
BACKLOG_MIN=5
PROPOSE_INTERVAL_HOURS=24
PROPOSE_MAX=3

# 리뷰 라운드 상한. 초과 시 PR 에 ai:needs-human
MAX_REVIEW_ROUNDS=3

# 계획 게이트(G2)를 생략할 이슈 type 라벨 (공백 구분, 예: "docs chore"). 기본: 모든 유형에 게이트 적용
AUTO_APPROVE_PLAN_TYPES=""

# 사람 게이트 도달·blocked 시 macOS 알림
NOTIFY=true

# 락이 이 시간(초)보다 오래되면 비정상 종료로 보고 해제
LOCK_STALE_SECONDS=21600
